{
  "schema": "parallax.cineswarm.archive-recovery-policy.c1.18.v0.1",
  "policyId": "pn0001-c1-18-archive-recovery-policy",
  "c17PolicyId": "pn0001-c1-17-public-archive-policy",
  "episodeId": "episode_pn_0001",
  "sequenceId": "pn0001-seq01-cold-open",
  "networkId": "parallax-network",
  "minimumReplicaCount": 2,
  "minimumDistinctFailureDomains": 2,
  "maxRestoreDrillAgeDays": 180,
  "restoreDrillAgeMeaning": "Internal Parallax disaster-recovery freshness policy; not an external preservation standard.",
  "requiredBundleKinds": [
    "public-release-receipt-json",
    "release-evidence-root-record",
    "published-master-media",
    "c1-15-public-release-register-json",
    "c1-16-release-lifecycle-register-json",
    "c1-17-public-archive-record-json",
    "c1-17-integrity-revalidation-json",
    "c1-17-public-archive-register-json"
  ],
  "requireC17IntegrityPass": true,
  "requireExactBundleInventoryParity": true,
  "requireDistinctReplicaLocations": true,
  "requireDistinctFailureDomains": true,
  "requireVerbatimPublishedMasterForFullRecovery": true,
  "requireHealthySourceReplicaForRestore": true,
  "requireByteForByteRestoreVerification": true,
  "appendOnlyRecoveryRegister": true,
  "restoreDrillNeverMutatesArchiveHistory": true,
  "autoRepublish": false,
  "recoveryCanAuthorizeRelease": false,
  "historyDeletionAllowed": false,
  "relayDependency": false
}
