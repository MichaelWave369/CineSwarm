{
  "schema": "parallax.cineswarm.signing-policy.c1.6.v0.1",
  "algorithm": "Ed25519",
  "privateKeyCustody": "external-human-controlled",
  "repositoryPrivateKeyStorageProhibited": true,
  "maxSealTtlSeconds": 86400,
  "maxExecutionEnvelopeTtlSeconds": 600,
  "singleUseExecutionEnvelopeRequired": true,
  "publicRelease": false,
  "relayDependency": false,
  "note": "Private signing material must never be stored in the Parallax Network repository or packaged sidecars."
}
